<Window xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    x:Class="PTR.GroundStation.Views.MainWindow"
    Title="PTR Ground Station Application">
    <SplitView IsPaneOpen="True"
        Name="MainSidebar"
        DisplayMode="CompactInline"
        CompactPaneLength="{StaticResource MainSidebarCompactWidth}"
        OpenPaneLength="{StaticResource MainSidebarOpenWidth}">
        <SplitView.Pane>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="{StaticResource MainSidebarColumnWidth}" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Classes="SidebarControl" Grid.Column="0">
                    <Button Name="SettingsButton"
                        ToolTip.Tip="{DynamicResource Text.SettingsTooltip}">
                        <PathIcon Data="{StaticResource Icon.Cogs}" />
                    </Button>
                    <Button Name="RocketsButton"
                        ToolTip.Tip="{DynamicResource Text.RocketsTooltip}">
                        <PathIcon Data="{StaticResource Icon.RocketLaunch}" />
                    </Button>
                    <Button Name="LogsButton"
                        ToolTip.Tip="{DynamicResource Text.LogsTooltip}">
                        <PathIcon Data="{StaticResource Icon.ContentSaveCog}" />
                    </Button>
                </StackPanel>
                <StackPanel Classes="SidebarContentContainer" Grid.Column="1">
                    <ContentControl Name="MainSidebarContent" />
                </StackPanel>
            </Grid>
        </SplitView.Pane>
        <Grid ColumnDefinitions="*, auto, *">
            <ContentControl Grid.Column="0" Name="LeftContent" />
            <GridSplitter Grid.Column="1" ResizeDirection="Columns" Margin="0"
                GridSplitter.Padding="0" />
            <Grid Grid.Column="2" RowDefinitions="*, auto, *">
                <ContentControl Grid.Row="0" Name="RightTopContent" />
                <GridSplitter Grid.Row="1" ResizeDirection="Rows" Margin="0" />
                <ContentControl Grid.Row="2" Name="RightBottomContent" Background="yellow" />
            </Grid>
        </Grid>
    </SplitView>
</Window>
