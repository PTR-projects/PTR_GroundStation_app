<Styles xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Styles.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="../Styles/ApplicationDimensions.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Styles.Resources>

    <Style Selector="GridSplitter">
        <Setter Property="Background" Value="{StaticResource SystemBaseMediumHighColor}" />
        <Setter Property="MinHeight" Value="2" />
        <Setter Property="MinWidth" Value="2" />
        <Setter Property="GridSplitter.Padding" Value="0" />
    </Style>

    <Style Selector="StackPanel.SidebarContentContainer > ContentControl">
        <Setter Property="Padding" Value="8" />
    </Style>
    <Style Selector=".SidebarControl">
        <Style Selector="^ Button">
            <Setter Property="Height" Value="{StaticResource Dimension.MainSidebarCompactWidth}" />
            <Setter Property="Width" Value="{StaticResource Dimension.MainSidebarCompactWidth}" />
            <Style Selector="^ PathIcon">
                <Setter Property="Width" Value="32" />
            </Style>
            <Style Selector="^.Active">
                <Setter Property="Background" Value="yellow" />
            </Style>
        </Style>
    </Style>
    <Style Selector="Border.SidebarPane">
        <Setter Property="Padding" Value="8" />
        <Style Selector="^ TextBox">
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>

        <Style Selector="^ TextBlock.H1">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="800" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <Style Selector="^ TextBlock.H2">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="600" />
            <Setter Property="Margin" Value="0,8,0,4" />
        </Style>

        <Style Selector="^ DataGridColumnHeader">
            <Style Selector="^ TextBlock">
                <Setter Property="TextAlignment" Value="Center" />
            </Style>
            <Setter Property="Padding" Value="4" />
        </Style>
        <Style Selector="^ DataGridColumnHeader">
            <Setter Property="Padding" Value="10" />
        </Style>
    </Style>
</Styles>
