<Window xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450" x:Class="PTR.GroundStation.MainWindow" Title="PTR Ground Station Application">
    <SplitView IsPaneOpen="True" DisplayMode="CompactInline" CompactPaneLength="100" OpenPaneLength="250">
        <SplitView.Pane>
            <Grid ColumnDefinitions="100,*">
                <StackPanel Grid.Column="0">
                    <Button Name="SettingsButton" Content="Settings" />
                    <Button Name="RocketsButton" Content="Rockets" />
                    <Button Name="LogsButton" Content="Logs" />
                </StackPanel>
                <ContentControl Name="PaneContentArea" Background="Blue" Grid.Column="1" />
            </Grid>
        </SplitView.Pane>
        <Grid ColumnDefinitions="*, 4, *">
            <ContentControl Grid.Column="0" Name="LeftContent" />
            <GridSplitter Grid.Column="1" Background="White" ResizeDirection="Columns"/>
            <Grid Grid.Column="2" RowDefinitions="*, 4, *">
                <ContentControl Grid.Row="0" Name="RightTopContent" />
                <GridSplitter Grid.Row="1" Background="White" ResizeDirection="Rows"/>
                <ContentControl Grid.Row="2" Name="RightBottomContent" />
            </Grid>
        </Grid>
    </SplitView>
</Window>
